# Copy to apps/worker/.env (gitignored) to run the worker locally against local Supabase.
# Values: `pnpm db:status` (API_URL, SECRET_KEY). WORKER_SECRET is any string; the database sends it
# in x-worker-secret, so it must match the Vault secret `worker_secret` (see README "Worker").
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
WORKER_SECRET=
